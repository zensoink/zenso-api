// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int              @id @default(autoincrement())
  name            String?
  email           String           @unique
  devices         Device[]
  widgets         Widget[]
  screens         Screen[]
  pluginInstances PluginInstance[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Widget {
  id        Int            @id @default(autoincrement())
  name      String
  template  String         //  LiquidJS HTML
  userId    Int
  user      User           @relation(fields: [userId], references: [id])
  displaySlots DeviceWidget[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Plugin {
  id            Int                  @id @default(autoincrement())
  manifestId    String               @unique
  slug          String               @unique
  name          String
  description   String?
  authorName    String?
  authorUrl     String?
  thumbnail     String?
  schemaVersion Int                  @default(1)
  coreMin       String?
  license       String?
  configSchema  Json?
  sourceType    String               @default("zip")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  versions      PluginVersion[]
  configs       PluginConfig[]
  events        PluginInstallEvent[]
  instances     PluginInstance[]
}

model PluginVersion {
  id              Int                  @id @default(autoincrement())
  pluginId        Int
  plugin          Plugin               @relation(fields: [pluginId], references: [id])
  version         String
  manifestJson    Json
  sourceUrl       String?
  sourceRef       String?
  checksumSha256  String?
  signatureStatus String               @default("none")
  installPath     String?
  executionMode   String               @default("local")
  status          String               @default("installed")
  installedAt     DateTime             @default(now())

  events          PluginInstallEvent[]
  instances       PluginInstance[]

  @@unique([pluginId, version])
}

model PluginConfig {
  id               Int      @id @default(autoincrement())
  pluginId         Int
  plugin           Plugin   @relation(fields: [pluginId], references: [id])
  scopeType        String   @default("global")
  scopeId          String?
  configJson       Json
  secretsEncrypted String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PluginInstallEvent {
  id              Int            @id @default(autoincrement())
  pluginId        Int
  plugin          Plugin         @relation(fields: [pluginId], references: [id])
  pluginVersionId Int?
  pluginVersion   PluginVersion? @relation(fields: [pluginVersionId], references: [id])
  eventType       String
  message         String?
  createdAt       DateTime       @default(now())
}

model Device {
  id        Int      @id @default(autoincrement()) // internal ID
  uid       String   @unique @default(uuid())      // public key
  name      String
  width     Int      @default(800)
  height    Int      @default(480)
  palette   String[] @default(["#000000", "#ffffff", "#00ff00", "#0000ff", "#ff0000", "#ffff00", "#ff8000"])

  slots     DeviceWidget[]
  screens   Screen[]

  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uid])
}


model DeviceWidget {
  id        Int      @id @default(autoincrement())
  deviceId  Int
  widgetId  Int
  position  Int      @default(0)  // slot position/order
  // Display data
  x         Int      @default(0)   //  position
  y         Int      @default(0)   // position
  w         Int      @default(12)
  h         Int      @default(12)
  device    Device   @relation(fields: [deviceId], references: [id])
  widget    Widget   @relation(fields: [widgetId], references: [id])
}

model Screen {
  id         Int          @id @default(autoincrement())
  name       String
  userId     Int
  user       User         @relation(fields: [userId], references: [id])
  deviceId   Int?
  device     Device?      @relation(fields: [deviceId], references: [id])
  layoutType String       @default("full")
  width      Int          @default(800)
  height     Int          @default(480)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  slots      ScreenSlot[]
}

model PluginInstance {
  id              Int             @id @default(autoincrement())
  pluginId        Int
  plugin          Plugin          @relation(fields: [pluginId], references: [id])
  pluginVersionId Int?
  pluginVersion   PluginVersion?  @relation(fields: [pluginVersionId], references: [id])
  name            String
  configJson      Json?
  executionMode   String          @default("local")
  isEnabled       Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  userId          Int
  user            User            @relation(fields: [userId], references: [id])

  screenSlots     ScreenSlot[]
}

model ScreenSlot {
  id              Int            @id @default(autoincrement())
  screenId        Int
  screen          Screen         @relation(fields: [screenId], references: [id])
  pluginInstanceId Int
  pluginInstance  PluginInstance @relation(fields: [pluginInstanceId], references: [id])
  slotKey         String
  x               Int            @default(0)
  y               Int            @default(0)
  w               Int            @default(0)
  h               Int            @default(0)
  zIndex          Int            @default(0)
  renderOrder     Int            @default(0)

  @@unique([screenId, slotKey])
}
