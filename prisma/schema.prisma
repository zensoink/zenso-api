// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  devices   Device[]
  widgets   Widget[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Widget {
  id        Int            @id @default(autoincrement())
  name      String
  template  String         //  LiquidJS HTML
  userId    Int
  user      User           @relation(fields: [userId], references: [id])
  displaySlots DeviceWidget[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Plugin {
  id            Int                  @id @default(autoincrement())
  manifestId    String               @unique
  slug          String               @unique
  name          String
  description   String?
  authorName    String?
  authorUrl     String?
  thumbnail     String?
  schemaVersion Int                  @default(1)
  coreMin       String?
  license       String?
  configSchema  Json?
  sourceType    String               @default("zip")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  versions      PluginVersion[]
  configs       PluginConfig[]
  events        PluginInstallEvent[]
}

model PluginVersion {
  id              Int                  @id @default(autoincrement())
  pluginId        Int
  plugin          Plugin               @relation(fields: [pluginId], references: [id])
  version         String
  manifestJson    Json
  sourceUrl       String?
  sourceRef       String?
  checksumSha256  String?
  signatureStatus String               @default("none")
  installPath     String
  status          String               @default("installed")
  installedAt     DateTime             @default(now())

  events          PluginInstallEvent[]

  @@unique([pluginId, version])
}

model PluginConfig {
  id               Int      @id @default(autoincrement())
  pluginId         Int
  plugin           Plugin   @relation(fields: [pluginId], references: [id])
  scopeType        String   @default("global")
  scopeId          String?
  configJson       Json
  secretsEncrypted String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PluginInstallEvent {
  id              Int            @id @default(autoincrement())
  pluginId        Int
  plugin          Plugin         @relation(fields: [pluginId], references: [id])
  pluginVersionId Int?
  pluginVersion   PluginVersion? @relation(fields: [pluginVersionId], references: [id])
  eventType       String
  message         String?
  createdAt       DateTime       @default(now())
}

model Device {
  id        Int      @id @default(autoincrement()) // internal ID
  uid       String   @unique @default(uuid())      // public key
  name      String
  width     Int      @default(800)
  height    Int      @default(480)
  palette   String[] @default(["#000000", "#ffffff", "#00ff00", "#0000ff", "#ff0000", "#ffff00", "#ff8000"])

  slots     DeviceWidget[]

  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uid])
}


model DeviceWidget {
  id        Int      @id @default(autoincrement())
  deviceId  Int
  widgetId  Int
  position  Int      @default(0)  // slot position/order
  // Display data
  x         Int      @default(0)   //  position
  y         Int      @default(0)   // position
  w         Int      @default(12)
  h         Int      @default(12)
  device    Device   @relation(fields: [deviceId], references: [id])
  widget    Widget   @relation(fields: [widgetId], references: [id])
}
