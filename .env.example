# ===== SERVER =====
NODE_ENV=development
PORT=3000
FRONTEND_URL="http://localhost:4200"  # frontend URL (CORS origin + QR code claim URL)

# ===== DATABASE (PostgreSQL) =====
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=zenso_user
DB_PASSWORD=zenso_password
DB_NAME=zenso_dev

# Connection URL (TypeORM będzie z tego korzystać)
DATABASE_URL=postgresql://zenso_user:zenso_password@postgres:5432/zenso_dev

# ===== LIQUIDS/RENDERING =====
# Render cache TTL in milliseconds. Default: 3600000 (1 hour) in production, 60000 in development.
RENDER_CACHE_TTL_MS=60000

# STORAGE
PLUGINS_ROOT_DIR="./storage/plugins" # optional

# ===== REGISTRY =====
REGISTRY_URL="https://registry.zenso.dev" # central plugin registry
MOCK_REGISTRY="true"

# ===== AUTH (JWT) =====
JWT_USER_SECRET=dev-user-secret-change-me
JWT_DEVICE_SECRET=dev-device-secret-change-me
JWT_USER_EXPIRES_IN=1h
JWT_DEVICE_EXPIRES_IN=1h

# ===== SEEDING =====
SEED_PLUGIN_URL="https://github.com/zensoink/zenso-plugin-template/releases/download/v0.0.0/plugin.zip" # plugin zip URL for initial seed
SEED_ON_STARTUP="true" # automatically seed database on app startup when empty
